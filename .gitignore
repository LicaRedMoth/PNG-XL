/build/
/build-vendored/
/build-asan/
/build-prof/
/kde/build/
# Staging prefixes used to point FFmpeg's pkg-config at a local libpxl build
/_inst/
/_inst_asan/
*.o
*.a
*.so
# Scratch encodes from development. The committed reference files under
# tests/data/ are exceptions: the suite decodes them to prove an older
# encoder's output still reads correctly.
*.pxl
*.apxl
!tests/data/*.pxl
!tests/data/*.apxl
pxl_interop_tmp.png

# Reference implementations / vendored upstreams (own repos, not part of our build)
/Zpng/
/FFmpeg/
/apngasm/
/apngdis-bin/

# Large local test assets (kept out of the repo; referenced by path)
/4YOU/
# Benchmark corpora and the video source: ~250 MB total, fetched locally.
# bench/README.md says where each one comes from.
/tests/data/Kodak-Lossless-True-Color-Image-Suite/
/tests/data/The-official-test-suite-for-PNG/
/tests/data/USC-SIPI-Image-Database/
# CLIC 2020 mobile training split: 1048 high-resolution photographs, 3.8 GB.
/tests/data/CLIC-2020-mobile-train/
# Anita: an industrial animation dataset. 16871 PNG frames in 367 shots, 11 GB.
# Three passes per shot (sketch/composition/color), so it is the first corpus
# that exercises .apxl cross-frame coding on real hand-drawn animation.
/tests/data/AnitaDataset/
/tests/data/Video_24fps.mp4
/tests/data/bad-apple.mp4
/tests/data/Video_24fps_96f.apng
/tests/data/Photorealistic_cover.png
/tests/data/Photorealistic_cover_fs8.png
# Personal capture folders. Benchmark material only -- never commit any of it.
# Screenshots is a symlink to a local folder; the other two are real
# directories that sit inside the tree, so without these rules a plain
# `git add -A` would stage them.
/tests/data/Screenshots
/tests/data/Screenrecords/
/tests/data/Nightrecords/
