diff --git a/libavformat/img2dec.c b/libavformat/img2dec.c
index d5718ef..9172631 100644
--- a/libavformat/img2dec.c
+++ b/libavformat/img2dec.c
@@ -1159,6 +1159,30 @@ static int qoi_probe(const AVProbeData *p)
     return AVPROBE_SCORE_MAX - 1;
 }
 
+/* .pxl still image: 24-byte header, "PXL1" magic, then one zstd frame.
+   Animated .apxl uses the "APXL" magic and its own demuxer. */
+static int pxl_probe(const AVProbeData *p)
+{
+    if (p->buf_size < 24)
+        return 0;
+
+    if (memcmp(p->buf, "PXL1", 4))
+        return 0;
+
+    if (p->buf[4] != 1)                     /* version */
+        return 0;
+    if (p->buf[5] < 1 || p->buf[5] > 4)     /* channels */
+        return 0;
+    if (p->buf[6] != 1 && p->buf[6] != 2)   /* bytes per channel */
+        return 0;
+    if (p->buf[7] > 2)                      /* color filter */
+        return 0;
+    if (!AV_RL32(p->buf + 8) || !AV_RL32(p->buf + 12))   /* dimensions */
+        return 0;
+
+    return AVPROBE_SCORE_MAX;
+}
+
 static int gem_probe(const AVProbeData *p)
 {
     const uint8_t *b = p->buf;
